# Default: normalize to LF in the repo
* text=auto eol=lf

# Explicit overrides for text formats
*.py    text eol=lf
*.rst   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.json  text eol=lf

# Binary — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.xlsx  binary
*.db    binary
*.ico   binary